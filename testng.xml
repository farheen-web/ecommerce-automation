<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">

<suite name="SDET Automation Suite"
       parallel="methods"
       thread-count="2">
       
       <listeners>
        <listener class-name="com.shopease.utils.TestListener"/>
    </listeners>

    <test name="Selenium Page Tests">
        <classes>
            <class name="com.shopease.tests.LoginTest"/>
            <class name="com.shopease.tests.DataProviderTest"/>
            <class name="com.shopease.tests.DataDrivenSeleniumTest"/>
            
        </classes>
    </test>

</suite>
